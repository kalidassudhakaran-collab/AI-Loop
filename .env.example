# Database
DATABASE_URL=

# Auth.js / NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Anthropic Claude API (M3-A — optional until key is available)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Embeddings (M3-B) — optional local provider; never invents vectors
# Supported: ollama | none
# Default model nomic-embed-text produces 768-d vectors (matches DB vector(768))
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text
# Ask LOOP (M3-C)
# Minimum cosine similarity (0–1) for evidence acceptance. Default 0.35
ASK_LOOP_MIN_SIMILARITY=0.35
# Set true to always include retrieval debug metadata in API responses
ASK_LOOP_DEBUG=
