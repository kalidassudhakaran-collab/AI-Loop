# Copy this file to .env and fill in values locally.
# Never commit .env — Git ignores it so you can push without keys.

# Database
DATABASE_URL=postgresql://loop_user:loop_password@localhost:5433/loop?schema=public

# Auth.js / NextAuth
# ADD locally: generate a random 32+ character secret. Do not commit the real value.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI text providers (classification, Ask LOOP answers, VoC narrative) ---
# Preference: Anthropic Claude (brief default) → Google Gemini (free fallback)
#
# ADD API (recommended free path):
#   1. Get a key at https://aistudio.google.com/apikey
#   2. Paste it below
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash
GEMINI_MODEL=

# ADD API (optional paid / brief-preferred):
# Get a key at https://console.anthropic.com/ → API keys
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=

# --- Embeddings for Ask LOOP ---
# Free cloud: gemini (uses GEMINI_API_KEY, 768-d text-embedding-004)
# Local: ollama (pull nomic-embed-text)
# Supported: gemini | ollama | none
EMBEDDING_PROVIDER=gemini
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# Optional. Defaults to gemini-embedding-001 (768-d via outputDimensionality)
EMBEDDING_MODEL=

# Ask LOOP
ASK_LOOP_MIN_SIMILARITY=0.35
ASK_LOOP_DEBUG=
