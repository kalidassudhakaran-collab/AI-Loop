generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  users     User[]
  feedback  Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  reports      Report[]

  @@index([workspaceId])
}

model Feedback {
  id                       String           @id @default(cuid())
  content                  String
  channel                  String
  sourceRef                String?
  customerLabel            String?
  sentiment                Sentiment?
  sentimentScore           Float?
  featureArea              String?
  classificationConfidence Float?
  classifiedAt             DateTime?
  status                   FeedbackStatus   @default(NEW)
  createdAt                DateTime         @default(now())
  workspaceId              String
  workspace                Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes                   FeedbackTheme[]
  embedding                Embedding?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, channel])
  @@index([workspaceId, sentiment])
  @@index([workspaceId, channel, status])
  @@index([workspaceId, classifiedAt])
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String          @default("#6366f1")
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedback    FeedbackTheme[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float    @default(0)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
}

/// Prepared for Week 3 Ask LOOP semantic search (pgvector).
enum EmbeddingStatus {
  PENDING
  READY
  FAILED
}

model Embedding {
  id         String          @id @default(cuid())
  feedbackId String          @unique
  feedback   Feedback        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  dimensions Int?
  provider   String?
  model      String?
  status     EmbeddingStatus @default(PENDING)
  error      String?
  /// Real pgvector column: vector(768) for nomic-embed-text. Not a fake Float[].
  /// See SQL migration — HNSW requires a fixed dimension.
  vector     Unsupported("vector(768)")?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  contentJson Json
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy String
  user        User      @relation(fields: [generatedBy], references: [id])

  @@index([workspaceId])
}
